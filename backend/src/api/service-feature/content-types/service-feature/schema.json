{
  "kind": "collectionType",
  "collectionName": "service_features",
  "info": {
    "singularName": "service-feature",
    "pluralName": "service-features",
    "displayName": "Service Feature",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::category.category",
      "inversedBy": "serviceFeatures"
    },
    "description": {
      "type": "text"
    },
    "picture": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images",
        "videos"
      ]
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    }
  }
}
