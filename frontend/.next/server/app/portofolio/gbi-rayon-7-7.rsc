a:[["$","article",null,{"className":"space-y-8 bg-primary text-gray-100","children":[["$","div",null,{"className":"py-16 px-8 lg:px-24 space-y-6","children":["$","div",null,{"className":"container mx-auto flex flex-col gap-2","children":[["$","h1",null,{"className":"leading-tight text-5xl","children":"GBI Rayon 7"}],["$","span",null,{"children":[null," / ",null]}],["$","span",null,{"children":"Social Media Management / Branding"}]]}]}],["$","div",null,{"className":"relative w-full h-[400px]","children":["$","$Lc",null,{"src":"https://admin.samsoec.my.id/uploads/Frame_1171276144_d474350adb.png","alt":"article cover image","fill":true,"objectFit":"cover","objectPosition":"center"}]}],["$","div",null,{"className":"py-16 px-8 lg:px-24 space-y-6","children":["$","div",null,{"className":"container mx-auto flex flex-col gap-2","children":[["$","p",null,{"children":"GBI Danau Bogor Raya adalah gereja yang berdiri di Bogor pada tanggal 11 Juni 1995 dan berada di bawah Sinode Gereja Bethel Indonesia. Gereja ini dipimpin oleh Pdt Ir Sutadi Rusli. Setiap minggu, ibadah raya dilaksanakan di Grha Amal Kasih, Danau Bogor Raya, dengan Perjamuan Kudus yang diadakan setiap Minggu kedua. Ibadah perdana di gedung Grha Amal Kasih diadakan pada tanggal 14 Agustus 2022. Gereja ini memiliki visi dan misi sebagai gereja yang berkomitmen untuk berdoa, memuji, dan menyembah bersama-sama siang dan malam, sebagai persiapan untuk menyambut kedatangan kedua Tuhan."}],[]]}]}]]}],[["$","div",null,{"className":"py-8 px-4 lg:px-0 bg-primary text-gray-100","children":["$","div",null,{"className":"container mx-auto space-y-6 divide-y divide-gray-400 md:space-y-12 divide-opacity-50","children":["$","div",null,{"className":"flex flex-col md:flex-row gap-8 justify-between items-center","children":[["$","p",null,{"className":"text-4xl md:text-6xl text-center md:text-left font-semibold max-w-lg","children":"Mari berkolaborasi dengan kami!"}],["$","div",null,{"className":"relative h-[160px] w-[160px] transit