a:[["$","$Lc","0",{"data":{"id":2,"__component":"sections.service-group","heading":"Talamalama Menyediakan Berbagai Layanan Untuk Bisnis Anda","categories":{"data":[{"id":4,"attributes":{"name":"Design","slug":"design","description":"Talamalama menyediakan jasa Design mulai dari Bradning, Social Media Management, UI/UX Design, Web Design dan Ecommerce Design.","serviceFeatures":{"data":[{"id":1,"attributes":{"name":"Branding","description":"Logo dan identitas brand yang kuat adalah kunci yang sangat penting dalam membangun daya tarik dan kepercayaan publik. Logo mencerminkan kepribadian brand dan menjadi simbol pengenalan yang ikonik. ","slug":"branding","picture":{"data":{"id":24,"attributes":{"url":"/uploads/Frame_1171276144_d474350adb.png","alternativeText":"Laptop","caption":null,"width":628,"height":577}}}}},{"id":2,"attributes":{"name":"Social Media Management","description":"Dengan industri dan tren yang unik, kami mengembangkan strategi pemasaran dan konten khusus untuk mencapai sweet spot dalam hal bisnis anda, target audiens, dan hasil pemasaran yang diinginkan.","slug":"social-media-management","picture":{"data":{"id":24,"attributes":{"url":"/uploads/Frame_1171276144_d474350adb.png","alternativeText":"Laptop","caption":null,"width":628,"height":577}}}}},{"id":3,"attributes":{"name":"UI/UX Design","description":"Proses design pembuatan mobile app melibatkan tahapan kreatif yang menyeluruh, mulai dari perencanaan user interface, warna dan elemen design yang menarik, hingga pengujian untuk menghasilkan pengalaman yang memikat.","slug":"ui-ux-design","picture":{"data":{"id":24,"attributes":{"url":"/uploads/Frame_1171276144_d474350adb.png","alternativeText":"Laptop","caption":null,"width":628,"height":577}}}}},{"id":4,"attributes":{"name":"Web Design","description":"Pembuatan landing page melibatkan penelitian mendalam tentang tujuan perusahaan, perencanaan design yang menarik, serta pengembangan tata letak yang responsif yang bertujuan untuk memikat pengunjung.","slug":"web-design","picture":{"data":{"id":24,"attributes":{"url":"/uploads/Frame_1171276144_d474350adb.png","alternativeText":"Laptop","caption":null,"width":628,"height":577}}}}},{"id":5,"attributes":{"name":"E-commerce Design","description":"Berfokus pada kegunaan dan kemudahan penggunaan, sistem pembayaran yang aman, fitur transaksi yang efisien, serta pengujian untuk memastikan pengalaman belanja online yang lancar dan memuaskan bagi pengguna.","slug":"e-commerce-design","picture":{"data":{"id":24,"attributes":{"url":"/uploads/Frame_1171276144_d474350adb.png","alternativeText":"Laptop","caption":null,"width":628,"height":577}}}}}]}}},{"id":6,"attributes":{"name":"Marketing","slug":"marketing","description":"Talamalama menggabungkan strategi pemasaran kreatif dan digital ke dalam satu sistem yang dapat membantu meningkatkan eksposur dan profitabilitas bisnis anda.","serviceFeatures":{"data":[{"id":9,"attributes":{"name":"Social Media Ads","description":"Kami memiliki tim ahli yang berpengalaman dalam mengelola kampanye iklan media soacial atau google dan memastikan bahwa setiap strategi kampanye dirancang untuk mencapai tujuan yang efektif untuk hasil yang terbaik.","slug":"social-media-ads","picture":{"data":{"id":24,"attributes":{"url":"/uploads/Frame_1171276144_d474350adb.png","alternativeText":"Laptop","caption":null,"width":628,"height":577}}}}},{"id":10,"attributes":{"name":"SEO","description":"Dengan layanan kami, anda dapat meningkatkan traffic organik ke situs web dan kesadaran brand anda, jangan lewatkan kesempatan untuk bersaing di dunia digital. Hubungi kami untuk memulai kampanye SEO anda!","slug":"seo","picture":{"data":{"id":24,"attributes":{"url":"/uploads/Frame_1171276144_d474350adb.png","alternativeText":"Laptop","caption":null,"width":628,"height":577}}}}},{"id":11,"attributes":{"name":"Google Ads","description":"Dengan industri dan tren yang unik, kami megembangkan strategi pemasaran dan konten khusus menggunakan budget untuk mencapai top search di Google.","slug":"google-ads","picture":{"data":{"id":24,"attributes":{"url":"/uploads/Frame_1171276144_d474350adb.png","alternativeText":"Laptop","caption":null,"width":628,"height":577}}}}},{"id":12,"attributes":{"name":"Influencer Management","description":"Jasa KOL Management yang profesional dan inovatif untuk membantu memperkuat merek anda. Tim kami memiliki pengetahuan tentang pasar dan tren terkini. Kami dapat mengidentifikasi, megelola dan berkolaborasi dengan influencer.","slug":"influencer-management","picture":{"data":{"id":24,"attributes":{"url":"/uploads/Frame_1171276144_d474350adb.png","alternativeText":"Laptop","caption":null,"width":628,"height":577}}}}},{"id":13,"attributes":{"name":"Paid Promotion","description":"Tingkatkan daya tarik produk anda dengan memperkaya visual melalui fotografi yang luar biasa, yang akan memberikan tampilan yang menarik, menghidupkan produk anda dan menarik perhatian pelanggan untuk membangun hubungan dengan anda.","slug":"paid-promotion","picture":{"data":{"id":24,"attributes":{"url":"/uploads/Frame_1171276144_d474350adb.png","alternativeText":"Laptop","caption":null,"width":628,"height":577}}}}}]}}},{"id":5,"attributes":{"name":"Photography","slug":"photography","description":"Talamalama mengerti bahwa penampilan produk melalui gambar maupun video dapat menjadi kunci penting keberhasilan bisnis anda.","serviceFeatures":{"data":[{"id":6,"attributes":{"name":"Product Photography","description":"Tingkatkan daya tarik produk anda dengan memperkaya visual melalui fotografi yang luar biasa, yang akan memberikan tampilan yang menarik, menghidupkan produk anda dan menarik perhatian pelanggan untuk membangun hubungan dengan anda.","slug":"product-photography","picture":{"data":{"id":24,"attributes":{"url":"/uploads/Frame_1171276144_d474350adb.png","alternativeText":"Laptop","caption":null,"width":628,"height":577}}}}},{"id":7,"attributes":{"name":"Event Photography","description":"Tingkatkan daya tarik produk anda dengan memperkaya visual melalui fotografi yang luar biasa, yang akan memberikan tampilan yang menarik, menghidupkan produk anda dan menarik perhatian pelanggan untuk membangun hubungan dengan anda.","slug":"event-photography","picture":{"data":{"id":24,"attributes":{"url":"/uploads/Frame_1171276144_d474350adb.png","alternativeText":"Laptop","caption":null,"width":628,"height":577}}}}},{"id":8,"attributes":{"name":"Videography","description":"Tingkatkan daya tarik produk anda dengan memperkaya visual melalui fotografi yang luar biasa, yang akan memberikan tampilan yang menarik, menghidupkan produk anda dan menarik perhatian pelanggan untuk membangun hubungan dengan anda.","slug":"videography","picture":{"data":{"id":24,"attributes":{"url":"/uploads/Frame_1171276144_d474350adb.png","alternativeText":"Laptop","caption":null,"width":628,"height":577}}}}}]}}}]}}}],["$","div",null,{"className":"py-8 px-4 lg:px-0 bg-primary text-gray-100","children":["$","div",null,{"className":"container mx-auto space-y-6 divide-y divide-gray-400 md:space-y-12 divide-opacity-50","children":["$","div",null,{"className":"flex flex-col md:flex-row gap-8 justify-between items-center","children":[["$","p",null,{"className":"text-4xl md:text-6xl text-center md:text-left font-semibold max-w-lg","children":"Mari berkolaborasi dengan kami!"}],["$","div",null,{"className":"relative h-[160px] w-[160px] transition ease-in-out delay-150 hover:scale-110","children":["$","$Ld",null,{"href":"https://www.instagram.com/talamalama/","target":"_blank","children":["$","$Le",null,{"src":"https://admin.samsoec.my.id/uploads/Frame_1171276118_ea3c42ff9a.svg","alt":"reach-us","layout":"fill"}]}]}]]}]}]}],["$","div",null,{"className":"bg-primary","children":["$","div","2",{"className":"container border-b-2 border-b-gray-700 mx-auto"}]}]]
